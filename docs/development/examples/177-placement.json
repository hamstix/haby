{
  "apiVersion": "haby.dev/v1alpha1",
  "kind": "KubernetesPlacement",
  "metadata": {
    "name": "standard",
    "revision": 1
  },
  "spec": {
    "namespace": "production",
    "registry": "registry.customer.local",
    "repositoryPrefix": "product",
    "strategy": {
      "type": "RollingUpdate"
    },
    "nodeSelector": {
      "kubernetes.io/os": "linux"
    },
    "imagePullSecrets": [
      "registry"
    ]
  }
}
