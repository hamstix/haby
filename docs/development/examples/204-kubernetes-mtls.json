{
  "apiVersion": "haby.dev/v1alpha1",
  "kind": "Provider",
  "metadata": { "name": "cluster", "environment": "staging" },
  "spec": {
    "revision": 1,
    "providerKind": "kubernetes/v1",
    "configurationContract": "haby.kubernetes.connection/v1",
    "implementationId": "haby.kubernetes/v1",
    "properties": { "endpoint": "https://api.example:6443" },
    "secretRefs": {
      "client-certificate": { "secretName": "cluster-certificate", "version": 2 },
      "client-private-key": { "secretName": "cluster-private-key", "version": 2 }
    }
  }
}
