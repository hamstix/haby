{
  "apiVersion": "haby.dev/v1alpha1",
  "kind": "KubernetesPlacement",
  "metadata": { "name": "standard-runtime", "revision": 1 },
  "spec": {
    "namespace": "applications",
    "registry": "registry.example.test",
    "repositoryPrefix": "team",
    "nodeSelector": { "example.test/pool": "applications" },
    "imagePullSecrets": ["existing-registry-credentials"],
    "replicas": 2,
    "strategy": { "type": "RollingUpdate", "maxSurge": "25%", "maxUnavailable": 0 },
    "minReadySeconds": 5,
    "rolloutSeconds": 600,
    "resources": {
      "requests": { "cpu": "250m", "memory": "128Mi" },
      "limits": { "cpu": "1", "memory": "1Gi" }
    },
    "service": { "enabled": true },
    "headlessService": { "enabled": false },
    "ingress": { "enabled": true, "className": "nginx", "domain": "apps.example.test", "tlsSecret": "existing-tls" }
  }
}
