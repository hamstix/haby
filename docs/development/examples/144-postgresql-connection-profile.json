{
  "apiVersion": "haby.dev/v1alpha1",
  "kind": "ConfigurationProfile",
  "metadata": { "id": "postgresql-layout", "revision": 1 },
  "spec": {
    "documents": {
      "settings": { "fileName": "appsettings.json", "format": "json", "template": {} }
    },
    "bindingRules": {
      "connection": {
        "slot": "main-database",
        "rendererRef": "postgresql.npgsql-connection/v1alpha1",
        "options": { "sslMode": "disable" },
        "documentProjections": [
          { "documentRef": "settings", "path": "/PostgreSQL/DefaultConnection/ConnectionString" }
        ]
      }
    }
  }
}
