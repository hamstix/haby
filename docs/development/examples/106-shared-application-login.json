{
  "apiVersion": "haby.dev/v1alpha1",
  "kind": "Application",
  "metadata": {
    "id": "sample-app",
    "displayName": "Shared application login proposal"
  },
  "spec": {
    "resources": {
      "db": {
        "type": "postgresql.database/v1alpha1",
        "providerRef": "postgresql.primary",
        "properties": { "name": "sample_app" },
        "lifecycle": { "deletionPolicy": "retain" }
      },
      "app-login": {
        "type": "postgresql.application-login/v1alpha1",
        "providerRef": "postgresql.primary",
        "properties": {
          "databaseRef": "db",
          "schema": "app",
          "privilegePolicy": "schema-migrator/v1"
        },
        "lifecycle": { "deletionPolicy": "retain" }
      }
    },
    "components": {
      "api": {
        "bindings": {
          "storage": {
            "target": { "kind": "local-resource", "resourceRef": "app-login" },
            "options": {}
          }
        }
      },
      "worker": {
        "bindings": {
          "storage": {
            "target": { "kind": "local-resource", "resourceRef": "app-login" },
            "options": {}
          }
        }
      }
    }
  }
}
