{
  "apiVersion": "haby.dev/v1alpha1",
  "kind": "Application",
  "metadata": { "id": "profile-consumer" },
  "spec": {
    "resources": {
      "app-login": { "type": "sample.resource/v1", "providerRef": "available" }
    },
    "components": {
      "api": {
        "bindings": {
          "database": {
            "target": { "kind": "local-resource", "resourceRef": "app-login" },
            "configurationSlot": "main"
          }
        }
      },
      "worker": {
        "bindings": {
          "database": {
            "target": { "kind": "local-resource", "resourceRef": "app-login" },
            "configurationSlot": "main"
          }
        }
      }
    }
  }
}
