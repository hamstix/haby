{
  "apiVersion": "haby.dev/v1alpha1",
  "kind": "ConfigurationProfile",
  "metadata": {
    "id": "telemetry",
    "revision": 1
  },
  "spec": {
    "staticContributions": {
      "logging": {
        "documentRef": "settings",
        "path": "/Serilog",
        "value": {
          "WriteTo": [{ "Name": "LokiHttp", "Args": { "lokiUrl": "https://logs.example.invalid/insert/loki/api/v1/push" } }]
        },
        "secretProjections": [{
          "path": "/WriteTo/0/Args/lokiPassword",
          "format": "string",
          "secretRef": { "name": "logging-password", "version": 1 }
        }]
      },
      "otel": {
        "documentRef": "settings",
        "path": "/OpenTelemetry",
        "value": {
          "EnableTracing": true,
          "EnableMetrics": true,
          "Otlp": { "Endpoint": "https://telemetry.example.invalid" }
        },
        "secretProjections": [
          {
            "path": "/Otlp/Headers",
            "format": "string",
            "secretRef": {
              "name": "telemetry-headers",
              "version": 1
            }
          }
        ]
      }
    }
  }
}
