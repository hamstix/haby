{
  "apiVersion": "haby.dev/v1alpha1",
  "kind": "ConfigurationProfile",
  "metadata": {
    "id": "telemetry",
    "revision": 1
  },
  "spec": {
    "staticContributions": {
      "otel": {
        "documentRef": "settings",
        "path": "/OpenTelemetry",
        "value": {
          "EnableTracing": true,
          "EnableMetrics": true
        },
        "secretProjections": [
          {
            "path": "/Otlp",
            "format": "json",
            "secretRef": {
              "name": "otel-connection",
              "version": 1
            }
          }
        ]
      }
    }
  }
}
