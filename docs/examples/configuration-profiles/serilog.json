{
  "apiVersion": "haby.dev/v1alpha1",
  "kind": "ConfigurationProfile",
  "metadata": {
    "id": "serilog",
    "revision": 1
  },
  "spec": {
    "staticContributions": {
      "logging": {
        "documentRef": "settings",
        "path": "/Serilog",
        "value": {
          "MinimumLevel": {
            "Default": "Information",
            "Override": {
              "Framework": "Warning"
            }
          }
        }
      }
    }
  }
}
